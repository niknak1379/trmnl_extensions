<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Doto:wght@100..900&family=Science+Gothic:wght@100..900&display=swap" rel="stylesheet">
 <link href="https://api.fontshare.com/v2/css?f[]=panchang@500&f[]=chillax@500&f[]=jet-brains-mono@400&display=swap" rel="stylesheet"> 
<div
  class="screen screen--{{ model.bit_depth }}bit screen--{{
    model.name
  }} screen--lg screen--{{ model.orientation }} screen--1x"
>
<style>
    *{
        font-family: 'Chillax', sans-serif;
        // font-family: 'JetBrains Mono', sans-serif;
        margin: 0px;
        box-sizing: border-box;
    }
    div.view{
        width: 800px;
        height: 480px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: stretch;
        gap: 8px;
        padding: 8px;
    }
    div.lists{
        display: flex;
        flex-direction: row;
        justify-content: space-around;
        align-items: stretch;
        gap: 16px;
        overflow: hidden;
    }
    div.listWrapper{
        display: flex;
        flex-direction: row;
        border: 2px solid black;
        flex-basis: 0;
        flex-grow: 1;
        justify-content: space-between;
        align-items: stretch;
        max-height: 100%;
        overflow: hidden;
        border-radius: 10px;
        background-color: lightgray;
    }
    div.listWrapper > span{
        font-family: 'JetBrains Mono', sans-serif;
        padding-top: 2em;
        font-size: 20px;
        text-align: center;
        font-weight: bolder;
        writing-mode: vertical-rl; 
        align-self: flex-start !important;
    }

    ul{
        font-size: 20px;
        display: flex;
        flex-direction: column;
        justify-content: start;
        align-items: stretch !important;
        gap: 16px;
        flex-grow: 1;
        padding: 12px;
        border-left: 2px solid black;
        background-color: white;
    }
    li{
        list-style: none;
        border: 4px solid black;
        box-shadow: 5px 5px gray;
        font-weight: bold;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        
        padding: 4px;
    }
    li span.cardProperties {
        display: flex;
        flex-direction: row;
        justify-content: start;
        background-color: lightgray;
        gap: 8px;
        padding-left: 4px;
        padding-right: 4px;
    }
    li span.priority,
    li span.dueDate{
        font-family: 'Panchang', sans-serif;
        font-size: 12px;
        font-weight: bolder;
    }
</style>
  <div class="view view--full">
    <div class="lists">
        {% for item in lists %}
            <div class="listWrapper">
                <span> {{item.status}} </span>
                <ul>
                    {% for task in item.list %}
                        <li>
                            <span class="cardProperties">

                                {% if task.dueDate %}
                                    <span class="dueDate">{{task.dueDate}}</span>
                                {% endif %}

                                {% if task.priority %}
                                 <span class="priority">{{task.priority}}</span>
                                {% endif %}

                            </span>
                            <span class="title">{{task.title}}</span>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
    </div>
  </div>
</div>
