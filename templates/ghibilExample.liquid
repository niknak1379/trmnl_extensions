<div
  class="screen screen--{{model.bit_depth}}bit screen--{{model.name}} screen--lg screen--{{model.orientation}} screen--1x"
>
  <div class="view view--full">
    {% for item in data limit:5 %}
    <div class="item">
      <div class="meta">
        <span class="index">{{ forloop.index }}</span>
      </div>

      <img src="{{item.image}}" width="50" height="50" />

      <div class="content">
        <span class="title title--small">{{ item.title }}</span>
        <span class="description">{{ item.description | truncate: 100}}</span>
      </div>
    </div>
    {% endfor %}
  </div>
</div>